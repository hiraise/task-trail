# The web's nginx on the local stack: SPA static files and an /api proxy to the server on the same origin, so no CORS.
server {
  listen 3000;
  root /usr/share/nginx/html;

  location /api/ {
    proxy_pass http://server:8080/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # The stripped prefix: Gin builds its redirect URLs from it (e.g. to a path without a trailing "/")
    proxy_set_header X-Forwarded-Prefix /api;
    # Request body limit matches the server (ADR-0013): an avatar up to 5 MB (entity.MaxAvatarSize) plus 64 KB
    # for multipart headers (multipartOverhead in server/internal/presentation/http/v1/request/user.go)
    client_max_body_size 5184k;
  }

  # Build files with a hash in the name: a missing one is a 404, not index.html instead of a script
  location /assets/ {
    try_files $uri =404;
  }

  location / {
    # index.html is not cached: after a rebuild the browser gets the new build file names right away
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
