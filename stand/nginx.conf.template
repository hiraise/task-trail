# nginx веба на стенде: статика SPA и прокси /api на сервер с тем же origin — CORS не нужен.
server {
  listen 3000;
  root /usr/share/nginx/html;

  location /api/ {
    proxy_pass http://server:8080/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Срезанный префикс: по нему Gin строит адреса своих редиректов (например, на путь без «/» в конце)
    proxy_set_header X-Forwarded-Prefix /api;
    # Тело запроса — как у сервера (ADR-0013): аватарка до 5 МБ (entity.MaxAvatarSize) и 64 КБ
    # на заголовки multipart (multipartOverhead в server/internal/presentation/http/v1/request/user.go)
    client_max_body_size 5184k;
  }

  # Файлы сборки с хешем в имени: несуществующий — 404, а не index.html вместо скрипта
  location /assets/ {
    try_files $uri =404;
  }

  location / {
    # index.html не кешируется: после пересборки браузер сразу получает новые имена файлов сборки
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
